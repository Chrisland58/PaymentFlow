{
  "title": "StellarEduPay — SLO Dashboard",
  "uid": "stellaredupay-slos",
  "description": "Service Level Objectives for PaymentFlow. Each row covers one SLO: target, current value, error-budget burn, and trend. Panels link to runbooks via the panel description. See docs/slo-definitions.md for the full SLO catalogue.",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "60s",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "tags": ["slo", "payments", "reliability"],
  "links": [
    {
      "title": "SLO Definitions",
      "url": "https://github.com/onlyonee1/PaymentFlow/blob/main/docs/slo-definitions.md",
      "type": "link",
      "icon": "doc",
      "tooltip": "Full SLO catalogue with targets, windows, and error-budget policy",
      "targetBlank": true
    },
    {
      "title": "SLO Runbooks",
      "url": "https://github.com/onlyonee1/PaymentFlow/blob/main/docs/runbooks/",
      "type": "link",
      "icon": "bolt",
      "tooltip": "Runbooks for each SLO alert",
      "targetBlank": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [

    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 2 },
      "options": {
        "mode": "markdown",
        "content": "## SLO-1 — API Availability (target ≥ 99.5 %)\n**Metric:** fraction of non-5xx HTTP requests. Error budget: ~3.6 h/month. [Runbook](https://github.com/onlyonee1/PaymentFlow/blob/main/docs/runbooks/slo-api-availability.md)"
      }
    },

    {
      "id": 10,
      "title": "API Availability — Current (5 m window)",
      "description": "Current fraction of successful (non-5xx) requests. SLO target: ≥ 99.5 %. Red threshold at 99.5 %.",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 2, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "slo:api_availability:ratio_rate5m * 100",
          "legendFormat": "availability %",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 98,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": 0 },
              { "color": "yellow", "value": 99 },
              { "color": "green",  "value": 99.5 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "id": 11,
      "title": "API Error Ratio — 30 m (burn rate)",
      "description": "Error ratio over 30 minutes. Burn rate = value / 0.005 (monthly budget rate). Alert fires at 6× = 3 %.",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 2, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "slo:api_error_ratio:rate5m * 100",
          "legendFormat": "error % (5 m)"
        },
        {
          "expr": "slo:api_error_ratio:rate30m * 100",
          "legendFormat": "error % (30 m)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": 0 },
              { "color": "yellow", "value": 0.5 },
              { "color": "red",    "value": 3 }
            ]
          }
        }
      }
    },

    {
      "id": 12,
      "title": "API Error Budget Remaining",
      "description": "Approximate fraction of the monthly 0.5% error budget remaining, estimated from the 30 m burn rate. Below 0 means the budget is exhausted.",
      "type": "stat",
      "gridPos": { "x": 18, "y": 2, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "(1 - (slo:api_error_ratio:rate30m / 0.005)) * 100",
          "legendFormat": "budget remaining",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": 0 },
              { "color": "yellow", "value": 25 },
              { "color": "green",  "value": 50 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },

    {
      "id": 2,
      "type": "text",
      "title": "",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 2 },
      "options": {
        "mode": "markdown",
        "content": "## SLO-2 — Payment Confirmation Latency (target: p95 ≤ 60 s for ≥ 95 % of payments)\n**Metric:** `payment_processing_duration_seconds`. [Runbook](https://github.com/onlyonee1/PaymentFlow/blob/main/docs/runbooks/slo-payment-latency.md)"
      }
    },

    {
      "id": 20,
      "title": "Payment Confirmation p95 Latency",
      "description": "95th-percentile time from blockchain detection to CONFIRMED status. SLO target: ≤ 60 s. Alert fires at 30 s (fast burn) and 10 s sustained (slow burn).",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 10, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "slo:payment_processing_p95:rate5m",
          "legendFormat": "p95 latency",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "max": 120,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": 0 },
              { "color": "yellow", "value": 10 },
              { "color": "orange", "value": 30 },
              { "color": "red",    "value": 60 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "id": 21,
      "title": "Payment Processing Latency Percentiles",
      "description": "p50, p95, p99 of the full payment processing pipeline. SLO target: p95 ≤ 60 s.",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 10, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(payment_processing_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "slo:payment_processing_p95:rate5m",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(payment_processing_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": 0 },
              { "color": "yellow", "value": 10 },
              { "color": "red",    "value": 60 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          }
        ]
      }
    },

    {
      "id": 22,
      "title": "Payments Within SLO (< 60 s)",
      "description": "Fraction of payments confirmed within the 60 s SLO target. SLO target: ≥ 95 %.",
      "type": "stat",
      "gridPos": { "x": 18, "y": 10, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "slo:payment_within_slo:ratio_rate5m * 100",
          "legendFormat": "within SLO",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": 0 },
              { "color": "yellow", "value": 90 },
              { "color": "green",  "value": 95 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },

    {
      "id": 3,
      "type": "text",
      "title": "",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 2 },
      "options": {
        "mode": "markdown",
        "content": "## SLO-3 — Webhook Delivery Success (target ≥ 99 %)\n**Metric:** `webhook_delivery_total{outcome}`. Error budget: 1 %. [Runbook](https://github.com/onlyonee1/PaymentFlow/blob/main/docs/runbooks/slo-webhook-delivery.md)"
      }
    },

    {
      "id": 30,
      "title": "Webhook Success Rate — Current",
      "description": "Current webhook delivery success rate. SLO target: ≥ 99 %. Alert fires at < 86 % (14× fast burn) and < 97 % (3× slow burn).",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 18, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "slo:webhook_success:ratio_rate5m * 100",
          "legendFormat": "webhook success %",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 80,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": 0 },
              { "color": "yellow", "value": 95 },
              { "color": "green",  "value": 99 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "id": 31,
      "title": "Webhook Delivery Rate by Outcome",
      "description": "Rate of webhook delivery attempts, broken down by outcome (success, failure, retry).",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 18, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(webhook_delivery_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "failure" }, "properties": [{ "id": "color", "value": { "fixedColor": "red",   "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "success" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "retry"   }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow","mode": "fixed" } }] }
        ]
      }
    },

    {
      "id": 32,
      "title": "Webhook Dead-Letter Count (by school)",
      "description": "Number of webhook deliveries in the dead-letter state per school. Any non-zero value requires manual action. See runbook.",
      "type": "stat",
      "gridPos": { "x": 18, "y": 18, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "sum(webhook_dead_letter_total)",
          "legendFormat": "total dead-letter",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": 0 },
              { "color": "yellow", "value": 1 },
              { "color": "red",    "value": 50 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },

    {
      "id": 4,
      "type": "text",
      "title": "",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 2 },
      "options": {
        "mode": "markdown",
        "content": "## SLO-4 — Blockchain Reconciliation Lag (target: 95 % of schools reconciled within 5 min)\n**Metric:** `horizon_poll_max_deferral_cycles`. Alert fires at > 3 cycles (warning) and > 9 cycles (critical ≈ 5 min breach). [Runbook](https://github.com/onlyonee1/PaymentFlow/blob/main/docs/runbooks/slo-reconciliation-lag.md)"
      }
    },

    {
      "id": 40,
      "title": "Max Reconciliation Lag — Worst School",
      "description": "Worst-case reconciliation lag across all schools (in minutes, assuming 30 s poll interval). SLO: ≤ 5 min for 95 % of schools.",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 26, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "slo:reconciliation_max_lag_minutes:approx",
          "legendFormat": "worst-case lag (min)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "min": 0,
          "max": 15,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": 0 },
              { "color": "yellow", "value": 1.5 },
              { "color": "orange", "value": 3 },
              { "color": "red",    "value": 5 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "id": 41,
      "title": "Deferred Schools & Deferral Cycles",
      "description": "Number of currently-deferred schools and worst-case consecutive deferral cycles over time.",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 26, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "horizon_poll_deferred_schools",
          "legendFormat": "deferred schools"
        },
        {
          "expr": "horizon_poll_max_deferral_cycles",
          "legendFormat": "max deferral cycles"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "max deferral cycles" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          }
        ]
      }
    },

    {
      "id": 42,
      "title": "Horizon Poll Budget Ceiling",
      "description": "Adaptive per-cycle Horizon request ceiling (AIMD-adjusted). A collapsed ceiling means the poll budget has been throttled by 429 responses.",
      "type": "stat",
      "gridPos": { "x": 18, "y": 26, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "horizon_poll_budget_ceiling",
          "legendFormat": "budget ceiling",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": 0 },
              { "color": "yellow", "value": 5 },
              { "color": "green",  "value": 20 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },

    {
      "id": 5,
      "type": "text",
      "title": "",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 2 },
      "options": {
        "mode": "markdown",
        "content": "## SLO-5 — Retry Queue Age / Error Budget (target: < 100 pending verifications)\n**Metric:** `pending_verification_backlog{status}`. Dead-letter entries require manual action. [Runbook](https://github.com/onlyonee1/PaymentFlow/blob/main/docs/runbooks/slo-retry-queue.md)"
      }
    },

    {
      "id": 50,
      "title": "Pending Verification Backlog",
      "description": "Depth of the pending-verification retry backlog. SLO target: < 100. Alert fires at > 50 (warning) and > 200 (critical).",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 34, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "slo:retry_queue_pending:current",
          "legendFormat": "pending",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 300,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": 0 },
              { "color": "yellow", "value": 50 },
              { "color": "orange", "value": 100 },
              { "color": "red",    "value": 200 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "id": 51,
      "title": "Verification Backlog by Status",
      "description": "Pending-verification queue depth broken down by status: pending, processing, resolved, dead_letter. Any dead_letter entries require immediate manual intervention.",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 34, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "pending_verification_backlog",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "dead_letter" }, "properties": [{ "id": "color", "value": { "fixedColor": "dark-red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "pending"     }, "properties": [{ "id": "color", "value": { "fixedColor": "orange",   "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "processing"  }, "properties": [{ "id": "color", "value": { "fixedColor": "blue",     "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "resolved"    }, "properties": [{ "id": "color", "value": { "fixedColor": "green",    "mode": "fixed" } }] }
        ]
      }
    },

    {
      "id": 52,
      "title": "Dead-Letter Count",
      "description": "Verifications in dead_letter state — have exhausted all retries. Non-zero requires immediate manual intervention via /api/admin/retry-queue.",
      "type": "stat",
      "gridPos": { "x": 18, "y": 34, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "slo:retry_queue_dead_letter:current",
          "legendFormat": "dead-letter",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": 0 },
              { "color": "red",    "value": 1 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },

    {
      "id": 6,
      "type": "text",
      "title": "",
      "gridPos": { "x": 0, "y": 40, "w": 24, "h": 2 },
      "options": {
        "mode": "markdown",
        "content": "## Error Budget Summary\nInstantaneous view of all five SLO budgets. Green = budget healthy, yellow = >25% consumed, red = budget exhausted or breached."
      }
    },

    {
      "id": 60,
      "title": "SLO-1 API Availability — Budget",
      "type": "stat",
      "gridPos": { "x": 0, "y": 42, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "slo:api_availability:ratio_rate30m * 100",
          "legendFormat": "SLO-1 availability",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": 0 },
              { "color": "yellow", "value": 99 },
              { "color": "green",  "value": 99.5 }
            ]
          },
          "mappings": []
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "text": { "titleSize": 14 } }
    },

    {
      "id": 61,
      "title": "SLO-2 Payment Latency — p95",
      "type": "stat",
      "gridPos": { "x": 5, "y": 42, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "slo:payment_processing_p95:rate5m",
          "legendFormat": "p95 latency",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": 0 },
              { "color": "yellow", "value": 10 },
              { "color": "red",    "value": 60 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "text": { "titleSize": 14 } }
    },

    {
      "id": 62,
      "title": "SLO-3 Webhook Success",
      "type": "stat",
      "gridPos": { "x": 10, "y": 42, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "slo:webhook_success:ratio_rate5m * 100",
          "legendFormat": "webhook success",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": 0 },
              { "color": "yellow", "value": 97 },
              { "color": "green",  "value": 99 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "text": { "titleSize": 14 } }
    },

    {
      "id": 63,
      "title": "SLO-4 Reconciliation Lag",
      "type": "stat",
      "gridPos": { "x": 14, "y": 42, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "slo:reconciliation_max_lag_minutes:approx",
          "legendFormat": "worst-case lag",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": 0 },
              { "color": "yellow", "value": 2 },
              { "color": "red",    "value": 5 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "text": { "titleSize": 14 } }
    },

    {
      "id": 64,
      "title": "SLO-5 Retry Queue Depth",
      "type": "stat",
      "gridPos": { "x": 19, "y": 42, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "slo:retry_queue_pending:current",
          "legendFormat": "pending",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": 0 },
              { "color": "yellow", "value": 50 },
              { "color": "red",    "value": 100 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "text": { "titleSize": 14 } }
    }

  ]
}
